{
  "name": "skellychart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate",
    "dev": "vite",
    "generate": "npm run generate:tiling-feasibility",
    "generate:tiling-feasibility": "tsx scripts/generate-tiling-feasibility.ts",
    "generate:aruco-dict": "tsx scripts/run-export-aruco-dict.ts",
    "verify:opencv-raster": "uv run --with opencv-contrib-python-headless python scripts/verify_charuco_raster.py",
    "check:version": "tsx scripts/check-app-version.ts",
    "check:dist": "tsx scripts/check-dist-version.ts",
    "prebuild": "npm run check:version",
    "build": "npm run generate && tsc -b && vite build",
    "postbuild": "npm run check:dist",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "qrcode": "^1.5.4",
    "svg2pdf.js": "2.8.1"
  }
}
