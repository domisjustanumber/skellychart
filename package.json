{
  "name": "skellychart",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:aruco-dict": "tsx scripts/run-export-aruco-dict.ts",
    "verify:opencv-raster": "uv run --with opencv-contrib-python-headless python scripts/verify_charuco_raster.py",
    "check:version": "tsx scripts/check-app-version.ts",
    "check:presets": "tsx scripts/check-presets.ts",
    "generate:banner": "tsx scripts/generate-banner-size.ts",
    "check:banner": "tsx scripts/generate-banner-size.ts --check",
    "check:dist": "tsx scripts/check-dist-version.ts",
    "check:home-golden": "tsx scripts/check-home-golden.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:shop": "tsx scripts/check-shop.ts",
    "prebuild": "npm run check:version",
    "build": "npm run check:presets && npm run check:banner && npm run check:links && npm run check:shop && npm run check:home-golden && tsc -b && vite build",
    "postbuild": "npm run check:dist",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "qrcode": "^1.5.4",
    "svg2pdf.js": "2.8.1"
  }
}
