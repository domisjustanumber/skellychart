{
  "name": "skellychart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate",
    "dev": "vite",
    "generate": "npm run generate:tiling-feasibility",
    "generate:tiling-feasibility": "tsx scripts/generate-tiling-feasibility.ts",
    "generate:aruco-dict": "tsx tests/run-export-aruco-dict.ts",
    "verify:opencv-aruco": "node tests/verify-opencv-aruco-bytes.mjs",
    "verify:opencv": "npm run verify:opencv-aruco && npm run verify:opencv-raster",
    "verify:opencv-raster": "uv run --no-project --with-requirements tests/opencv-qr-test/requirements.txt python tests/opencv-qr-test/verify_charuco_raster.py",
    "check:opencv-diff": "node tests/opencv-release-diff.mjs",
    "check:version": "tsx scripts/check-app-version.ts",
    "check:dist": "tsx scripts/check-dist-version.ts",
    "prebuild": "npm run check:version",
    "build": "npm run generate && tsc -b && vite build",
    "postbuild": "npm run check:dist",
    "test": "npm run build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
